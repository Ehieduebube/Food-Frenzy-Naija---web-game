# Server-side secrets for api/claim.mjs (LagosLife purchases). Never put real values in this file.
# Set them in Vercel: Project → Settings → Environment Variables. They are read only on the server.
# Never prefix them with VITE_ (Vite would copy anything named VITE_* into the browser bundle).

# Sandbox: the test secret from the Vatar dashboard (starts with vtr_test_).
VATAR_TEST_SECRET=

# After approval: the live secret (starts with vtr_live_).
VATAR_LIVE_SECRET=
